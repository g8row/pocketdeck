# deskd as a systemd user service, started with the graphical session (so it
# has WAYLAND_DISPLAY / DISPLAY and the session bus for tile actions).
#   deskd/linux/install.sh        install + start
#   journalctl --user -u deskd -f
[Unit]
Description=deskd: desk companion daemon for the TB-7304X tablet
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@DESKD_DIR@
ExecStart=@BUN@ main.ts
Restart=on-failure
RestartSec=3
# DESKD_SSH=off to disable the mainline-tablet tunnel; see deskd/README.md for the rest
Environment=DESKD_SSH=root@172.16.42.1

[Install]
WantedBy=graphical-session.target
