#!/bin/busybox sh
# TB-7304X sign-of-life initramfs. Works on the mainline kernel and on the stock 3.18 kernel.
#  - paints the screen red -> green -> blue (fb0, else /dev/mem at LK's fb_base)
#  - USB gadget: CDC-ACM serial shell + CDC-ECM ethernet 172.16.42.1 (telnet, http with dmesg)
#  - self-reboots after tb.autoreboot=<s> seconds (default 300) unless /tmp/stay exists, so the tablet returns to
#    Android with nobody touching it. Only reached when stage 2 is not started (tb.r=0, 2 failed tries, no rootfs).
#    Linux is the default boot target (U-Boot in `boot`), so the reboot sets LK's one-shot RTC recovery flag:
#    LK then starts Android from `recovery` directly (docs/mainline/plan-dualboot.md §1).
/bin/busybox mkdir -p /bin /sbin /usr/bin /usr/sbin /proc /sys /dev /tmp /run /www
/bin/busybox --install -s
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || { mount -t tmpfs tmpfs /dev; mdev -s; }
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config 2>/dev/null
mount -t pstore pstore /sys/fs/pstore 2>/dev/null
[ -e /dev/fb0 ] || { [ -e /dev/graphics/fb0 ] && ln -s /dev/graphics/fb0 /dev/fb0; }

LOG=/www/init.log
log() { echo "[tb7304] $*" > /dev/kmsg; echo "[tb7304] $*" >> $LOG; echo "[tb7304] $*" > /dev/tty0 2>/dev/null; }

AUTOREBOOT=300
for a in $(cat /proc/cmdline); do
	case "$a" in tb.autoreboot=*) AUTOREBOOT=${a#tb.autoreboot=} ;; esac
done
log "init up, kernel $(uname -r), autoreboot=${AUTOREBOOT}s"
log "cmdline: $(cat /proc/cmdline)"
lkpaint info >> $LOG 2>&1

paint() {
	if [ -e /dev/fb0 ]; then lkpaint fb "$1" >> $LOG 2>&1 && return; fi
	lkpaint mem "$1" >> $LOG 2>&1
}

# ---- 1. screen ------------------------------------------------------------
# With mediatek-drm the kernel console is already on the panel: leave it alone (no colour test, it only cost
# 1.5 s and flashed the screen). The red/green/blue paint stays as a sign of life for kernels where
# mediatek-drm did not come up (LK's framebuffer through lkfb/simpledrm or /dev/mem).
if [ "$(cat /sys/class/graphics/fb0/name 2>/dev/null)" = mediatekdrmfb ]; then
	log "display: mediatek-drm, console on screen"
else
	# fbcon (console=tty0 comes from LK's part of the cmdline) clears and redraws fb0, wiping the paint: unbind it.
	for v in /sys/class/vtconsole/vtcon*; do
		grep -q "frame buffer" $v/name 2>/dev/null && echo 0 > $v/bind
	done
	# LK leaves OVL0 layer 3 on top of the framebuffer with the "orange state" warning. Disabling the layer
	# (SRC_CON bit 3) stalls OVL until reset, so make it transparent instead: constant alpha 0 in L3_CON.
	if [ $(( $(devmem 0x1400702c 32) & 8 )) -ne 0 ]; then
		devmem 0x14007090 32 $(( $(devmem 0x14007090 32) & ~0xff ))
		log "OVL0 L3 (LK overlay) alpha set to 0"
	fi
	paint ff0000; usleep 500000
	paint 00ff00; usleep 500000
	paint 0000ff; usleep 500000
	log "paint done (fb0: $([ -e /dev/fb0 ] && echo yes || echo no))"
fi

# ---- 2. USB gadget --------------------------------------------------------
gadget_configfs() {
	G=/sys/kernel/config/usb_gadget/g1
	[ -d /sys/kernel/config/usb_gadget ] || return 1
	UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
	[ -n "$UDC" ] || { log "no UDC in /sys/class/udc"; return 1; }
	mkdir -p $G && cd $G || return 1
	echo 0x1d6b > idVendor        # Linux Foundation
	echo 0x0104 > idProduct       # Multifunction Composite Gadget
	echo 0x0200 > bcdUSB
	echo 0xEF > bDeviceClass; echo 0x02 > bDeviceSubClass; echo 0x01 > bDeviceProtocol
	mkdir -p strings/0x409
	echo "TB7304X-mainline" > strings/0x409/serialnumber
	echo "Lenovo (test)" > strings/0x409/manufacturer
	echo "TB-7304X mainline $(uname -r)" > strings/0x409/product
	mkdir -p configs/c.1/strings/0x409
	echo "ACM+ECM" > configs/c.1/strings/0x409/configuration
	echo 250 > configs/c.1/MaxPower
	mkdir -p functions/acm.usb0 && ln -s functions/acm.usb0 configs/c.1/
	if mkdir -p functions/ecm.usb0 2>/dev/null; then
		echo 02:00:00:73:04:01 > functions/ecm.usb0/host_addr
		echo 02:00:00:73:04:02 > functions/ecm.usb0/dev_addr
		ln -s functions/ecm.usb0 configs/c.1/
	fi
	echo "$UDC" > UDC
	cd /
	log "configfs gadget bound to $UDC"
}

gadget_android() {   # MTK 3.18 android_usb (stock kernel control run)
	A=/sys/class/android_usb/android0
	[ -d $A ] || return 1
	echo 0 > $A/enable
	echo 1d6b > $A/idVendor
	echo 0104 > $A/idProduct
	echo "Lenovo (test)" > $A/iManufacturer
	echo "TB-7304X stock-kernel initramfs" > $A/iProduct
	echo TB7304X-stock > $A/iSerial
	echo acm,rndis > $A/functions 2>/dev/null || echo acm > $A/functions
	[ -e $A/f_rndis/ethaddr ] && echo 02:00:00:73:04:01 > $A/f_rndis/ethaddr
	echo 1 > $A/enable
	log "android_usb gadget enabled: $(cat $A/functions)"
}

gadget_configfs || gadget_android || log "no USB gadget interface available"
# wait (up to 2 s) for the USB network interface instead of a fixed sleep
i=0; while [ $i -lt 20 ] && ! ip link show usb0 >/dev/null 2>&1 && ! ip link show rndis0 >/dev/null 2>&1; do usleep 100000; i=$((i + 1)); done
for i in usb0 rndis0; do
	if ip link show $i >/dev/null 2>&1; then
		ip addr add 172.16.42.1/24 dev $i; ip link set $i up
		log "net $i = 172.16.42.1"
		cat > /tmp/udhcpd.conf <<EOF
start 172.16.42.2
end 172.16.42.2
interface $i
option subnet 255.255.255.0
max_leases 1
lease_file /tmp/udhcpd.leases
EOF
		touch /tmp/udhcpd.leases; udhcpd /tmp/udhcpd.conf
	fi
done
telnetd -l /bin/sh -p 23
httpd -h /www -p 80

# serial shell on the ACM port (ttyGS0 on both kernels)
( while true; do
	[ -e /dev/ttyGS0 ] && setsid sh -c 'exec /bin/sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1'
	sleep 1
done ) &

# ---- 3. status for the Mac (http://172.16.42.1/) --------------------------
( while true; do
	dmesg > /www/dmesg.txt
	{ echo "== uname"; uname -a; echo "== cpuinfo"; cat /proc/cpuinfo; echo "== meminfo"; head -5 /proc/meminfo
	  echo "== iomem"; cat /proc/iomem; echo "== partitions"; cat /proc/partitions
	  echo "== udc"; ls /sys/class/udc; echo "== fb"; cat /sys/class/graphics/fb0/name 2>/dev/null
	  echo "== pstore"; ls /sys/fs/pstore 2>/dev/null; } > /www/status.txt 2>&1
	sleep 5
done ) &
# ---- 3b. display watcher (tb.dispwatch=0 turns it off) --------------------
# D2 addresses (this chip): RDMA0 0x14009000, DSI0 0x14012000, MUTEX 0x14015000, larb0 0x14016000. mt6735.dtsi is D1.
# Interrupt status registers are cleared after each read, so each line shows the events of the last second.
# frames: OVL INTSTA bit1 / RDMA bit2 = frame done; RDMA bit4 = FIFO underflow.
DISPWATCH=1
for a in $(cat /proc/cmdline); do case "$a" in tb.dispwatch=*) DISPWATCH=${a#tb.dispwatch=} ;; esac; done
if [ "$DISPWATCH" != 0 ]; then ( r() { devmem $1 32; }
	i=0
	while true; do
		ovl_sta=$(r 0x14007000); ovl_int=$(r 0x14007008); devmem 0x14007008 32 0
		rdma_int=$(r 0x14009004); devmem 0x14009004 32 0
		dsi_int=$(r 0x1401200c)
		line="t=$(cut -d' ' -f1 /proc/uptime) ovl sta=$ovl_sta int=$ovl_int src=$(r 0x1400702c) l0=$(r 0x14007f40) dbg=$(r 0x14007240)"
		line="$line rdma int=$rdma_int con=$(r 0x14009010) st=$(r 0x14009030) dsi int=$dsi_int dbg=$(r 0x14012148)/$(r 0x1401214c)"
		line="$line cg=$(r 0x14000100)/$(r 0x14000110) mutex_int=$(r 0x14015004) larb0=$(r 0x14016004) mmu_en=$(r 0x14016fc0)"
		echo "$line" >> /www/disp.log
		echo "[disp] $line" > /dev/kmsg
		i=$((i + 1)); [ $i -lt 180 ] && sleep 1 || sleep 10
	done ) &
fi

ls /www > /dev/null
log "ready: serial on ttyGS0, telnet/http on 172.16.42.1"
dmesg | grep -i -E 'lkfb|simple|musb|udc|mmc0|wdt|watchdog' > /dev/tty0 2>/dev/null

# ---- 3c. stage 2: Alpine (docs/mainline/plan-dualboot.md §2, research-rootfs.md) -----------------------------
# U-Boot puts tb.slot=<a|b|cache|rescue> at the front of the cmdline (no tb.slot: an older U-Boot, same as cache).
#   a/b     root on tbroot_a/b (ext4, `e2fsck -p` first); on failure the cache image below is tried
#   cache   root in /cache/linux/rootfs.img (loop); stage 1 gives up after 2 failed tries (bootcount, reset by
#           stage 2 after 60 s)
#   rescue  no stage 2 (tbrescue, booted by U-Boot after `max` unhealthy boots): shell, then Android after 300 s
# tb.r=0 also keeps us here. tbdata (ext4) is checked and mounted at /data when present. Only cache, the
# tbroot/tbdata partitions and the boot record are ever written. Any failure before switch_root falls through to
# the initramfs shell below, with telnet/http still running.
ROOTMODE=auto; SLOT=cache
for a in $(cat /proc/cmdline); do case "$a" in tb.r=*) ROOTMODE=${a#tb.r=} ;; tb.slot=*) SLOT=${a#tb.slot=} ;; esac; done
[ "$SLOT" = rescue ] && { log "rescue boot (tb.slot=rescue): no stage 2"; ROOTMODE=0; }
log "slot: $SLOT"
find_part() {
	for d in /sys/class/block/mmcblk0p*; do
		grep -qx "PARTNAME=$1" $d/uevent 2>/dev/null && { echo /dev/${d##*/}; return 0; }
	done
	return 1
}
# e2fsck -p: 0 clean, 1 fixed; 2 fixed but wants a reboot (it was mounted: never the case here, carry on);
# 4 and up: needs a human, so do not mount it
fsck_part() {
	[ -x /bin/e2fsck ] || { log "no e2fsck in the initramfs, mounting $1 unchecked"; return 0; }
	# skip time-based checks during early boot; harmless now that the RTC sets the clock
	[ -f /etc/e2fsck.conf ] || { mkdir -p /etc; printf '[options]\n\tbroken_system_clock = 1\n' > /etc/e2fsck.conf; }
	e2fsck -p "$1" >> $LOG 2>&1; r=$?
	[ $r -lt 4 ] && { [ $r -gt 0 ] && log "e2fsck $1: fixed (exit $r)"; return 0; }
	log "e2fsck $1: exit $r, not mounting it"; return 1
}
CACHE_MOUNTED=0
mount_cache() {
	[ $CACHE_MOUNTED = 1 ] && return 0
	C=$(find_part cache) || { log "stage 2: no cache partition"; return 1; }
	mkdir -p /mnt/cache
	mount -t ext4 -o rw,noatime,nosuid,nodev "$C" /mnt/cache || { log "stage 2: cannot mount $C"; return 1; }
	CACHE_MOUNTED=1
}
# root on tbroot_<slot>
try_slot() {
	P=$(find_part tbroot_$SLOT) || { log "stage 2: no tbroot_$SLOT partition"; return 1; }
	fsck_part $P || return 1
	mount -t ext4 -o rw,noatime $P /newroot || { log "stage 2: cannot mount $P"; return 1; }
	[ -x /newroot/sbin/init ] || { log "stage 2: no /sbin/init on $P"; umount /newroot; return 1; }
	mount_cache	# optional here: legacy scripts and the cache image's maintenance use /mnt/cache
	log "stage 2: root on $P (tbroot_$SLOT)"
}
# root in the loop image on cache
try_cache() {
	mount_cache || return 1
	IMG=/mnt/cache/linux/rootfs.img
	# Rootfs update: a new image dropped in as rootfs.img.gz (from stage 2, scp/ssh) replaces the old one here,
	# while nothing has it mounted. The old image is deleted first (cache is too small for both).
	if [ -f $IMG.gz ]; then
		log "stage 2: installing new rootfs from $IMG.gz"
		rm -f $IMG $IMG.tmp
		if gunzip -c $IMG.gz > $IMG.tmp && sync && mv $IMG.tmp $IMG; then
			rm -f $IMG.gz; echo 0 > /mnt/cache/linux/bootcount; sync; log "stage 2: new rootfs installed"
		else
			log "stage 2: rootfs update FAILED"; rm -f $IMG.tmp
		fi
	fi
	[ -f $IMG ] || { log "stage 2: no $IMG"; return 1; }
	n=$(cat /mnt/cache/linux/bootcount 2>/dev/null); n=${n:-0}
	if [ "$n" -ge 2 ]; then
		log "stage 2 failed $n times in a row, staying in the initramfs (echo 0 > /mnt/cache/linux/bootcount)"
		return 1    # leave cache mounted for inspection
	fi
	echo $((n + 1)) > /mnt/cache/linux/bootcount; sync
	mount -t ext4 -o loop,rw,noatime $IMG /newroot || { log "stage 2: cannot mount $IMG"; return 1; }
	[ -x /newroot/sbin/init ] || { log "stage 2: no /sbin/init in $IMG"; umount /newroot; return 1; }
	log "stage 2: root in $IMG (try $((n + 1)))"
}
try_rootfs() {
	[ "$ROOTMODE" = 0 ] && { log "stage 2 off"; return 1; }
	mkdir -p /newroot
	# boot record (docs/mainline/plan-dualboot.md §4): stage 1 is up and the eMMC answers. U-Boot counted the
	# attempt; stage 2 marks it healthy after 60 s. Best effort: a missing tool or partition only logs.
	tbstate stage kernel > /dev/null 2>&1 || log "tbstate: could not record stage kernel"
	case "$SLOT" in
	a|b) try_slot || { log "stage 2: tbroot_$SLOT failed, trying the cache image"; try_cache; } ;;
	*) try_cache ;;
	esac || return 1
	D=$(find_part tbdata) && fsck_part $D && mkdir -p /newroot/data &&
		{ mount -t ext4 -o rw,noatime,nosuid,nodev $D /newroot/data || log "stage 2: cannot mount $D"; }
	tbstate stage init > /dev/null 2>&1 || log "tbstate: could not record stage init"
	mkdir -p /newroot/usr/local/sbin && cp /bin/tbstate /newroot/usr/local/sbin/tbstate 2>/dev/null
	cp $LOG /newroot/var/log/tb7304-stage1.log 2>/dev/null
	# we are PID 1: kill -1 hits every other user process (telnetd, httpd, the status/display loops)
	kill -9 -1 2>/dev/null; sleep 1
	[ $CACHE_MOUNTED = 1 ] && mkdir -p /newroot/mnt/cache && mount --move /mnt/cache /newroot/mnt/cache
	for m in dev proc sys; do mount --move /$m /newroot/$m; done
	exec switch_root /newroot /sbin/init
}
# ---- 3d. boot menu (docs/mainline/plan-dualboot.md §5) -----------------------------------------------
# tb.menu=<s> on the cmdline sets the countdown (default 3), tb.menu=0 skips it. bootmenu only returns a choice;
# anything unexpected (no framebuffer, crash) is choice 0 = continue Linux, so the menu cannot block a boot.
MENU=3
for a in $(cat /proc/cmdline); do case "$a" in tb.menu=*) MENU=${a#tb.menu=} ;; esac; done
now_reboot() {
	sync
	echo 1 > /proc/sys/kernel/sysrq; echo s > /proc/sysrq-trigger; sleep 1; echo b > /proc/sysrq-trigger
	sleep 5; reboot -f
}
RTC=/sys/devices/platform/rtc-boot-mode/next_boot
if [ "$MENU" -gt 0 ] 2>/dev/null && [ -x /bin/bootmenu ]; then
	st=$(tbstate 2>/dev/null | sed -n 's/^error=//p;s/^linux_boots=//p' | tr '\n' ' ')
	set -- $st
	case "$1" in none|"") st="Linux boots: ${2:-?}" ;; *) st="Last fallback: $1" ;; esac
	bootmenu "$MENU" "$st" 2> /www/menu.log; c=$?
	cat /www/menu.log >> $LOG 2>/dev/null
	case $c in
	0) log "menu: Linux" ;;
	1) log "menu: Android (once, via U-Boot)"
	   tbstate set oneshot=android > /dev/null 2>&1 || echo recovery > $RTC; now_reboot ;;
	2) log "menu: Android without U-Boot"; echo recovery > $RTC; now_reboot ;;
	3) log "menu: rescue shell (no stage 2, no autoreboot)"; ROOTMODE=0; touch /tmp/stay ;;
	4) log "menu: U-Boot fastboot"; tbstate set oneshot=fastboot > /dev/null 2>&1 && now_reboot ;;
	5) log "menu: LK fastboot"; echo bootloader > $RTC; now_reboot ;;
	*) log "menu: exit $c, continuing with Linux" ;;
	esac
fi

try_rootfs

# ---- 4. self-reboot to Android (RTC recovery flag; a plain reboot would come back to Linux) ----
t=0
while true; do
	sleep 5; t=$((t + 5))
	if [ -e /tmp/stay ]; then continue; fi
	if [ "$AUTOREBOOT" -gt 0 ] && [ $t -ge "$AUTOREBOOT" ]; then
		log "autoreboot after ${t}s, to Android (RTC recovery flag)"
		echo recovery > /sys/devices/platform/rtc-boot-mode/next_boot 2>/dev/null ||
			log "no rtc-boot-mode: this reboot comes back to Linux"
		sync
		# fallback first: open the watchdog and never pet it (resets in ~10-30 s if reboot hangs)
		( exec 3>/dev/watchdog; sleep 600 ) 2>/dev/null &
		sleep 1
		reboot -f
	fi
done
