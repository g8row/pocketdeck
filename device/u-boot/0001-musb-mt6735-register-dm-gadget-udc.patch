--- a/drivers/usb/musb-new/mt6735.c	2026-11-16 23:48:15
+++ b/drivers/usb/musb-new/mt6735.c	2026-11-16 23:48:15
@@ -242,13 +242,27 @@
 	if (!ret)
 		printf("MTK MUSB OTG (Host)\n");
 #else
+	/*
+	 * With DM_USB_GADGET, musb_register() has no peripheral case and returns ERR_PTR(-EINVAL), which the
+	 * NULL check let through: no controller and no UDC ("couldn't find an available UDC"). Do what
+	 * ti-musb.c does: create the controller (this runs musb_gadget_setup()) and register its gadget.
+	 */
 	pdata.mode = MUSB_PERIPHERAL;
-	host->host = musb_register(&pdata, &glue->dev, base);
-	if (!host->host)
-		return -EIO;
+	host->host = musb_init_controller(&pdata, &glue->dev, base);
+	if (IS_ERR_OR_NULL(host->host)) {
+		ret = host->host ? PTR_ERR(host->host) : -EIO;
+		host->host = NULL;
+		return ret;
+	}
 	pinctrl_select_state(dev, "otg");
+	generic_phy_power_on(&glue->phys);
 
+	ret = usb_add_gadget_udc((struct device *)dev, &host->host->g);
+	if (ret)
+		return ret;
+
 	printf("MTK MUSB OTG (Peripheral)\n");
+	return 0;
 #endif
 	generic_phy_power_on(&glue->phys);
 
@@ -271,7 +285,9 @@
 {
 	struct mtk_musb_glue *glue = dev_get_priv(dev);
 
-	mtk_musb_interrupt(0, glue);
+	/* the handler takes the struct musb, not the glue */
+	if (glue->mdata.host)
+		mtk_musb_interrupt(0, glue->mdata.host);
 
 	return 0;
 }
