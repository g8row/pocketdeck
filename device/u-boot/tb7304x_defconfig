# Lenovo TB-7304X: U-Boot chainloaded by stock LK from the `recovery` partition (plan-boot-recovery.md, Phase 2).
# Derived from grandpplte_defconfig (mt6735-mainline u-boot 3d74bf1686). Differences are marked "tb:".
CONFIG_ARM=y
CONFIG_POSITION_INDEPENDENT=y
CONFIG_ARCH_MEDIATEK=y
# tb: LK loads the kernel blob at 0x40080000 (base 0x40000000 + kernel_offset 0x80000, 512 KiB aligned)
CONFIG_TEXT_BASE=0x40080000
CONFIG_SYS_MALLOC_LEN=0x2000000
CONFIG_SYS_MALLOC_F_LEN=0x8000
CONFIG_NR_DRAM_BANKS=1
CONFIG_ENV_SIZE=0x1000
CONFIG_DM_GPIO=y
CONFIG_DEFAULT_DEVICE_TREE="mt6737m-lenovo-tb7304x"
CONFIG_SYS_PROMPT="tb7304x> "
# CONFIG_PSCI_RESET is not set
CONFIG_SYS_LOAD_ADDR=0x40200000
CONFIG_CC_OPTIMIZE_FOR_SPEED=y
CONFIG_STACK_SIZE=0x0
# tb: `fastboot boot` of Android boot images
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_FIT=y
# CONFIG_BOOTMETH_DISTRO is not set
CONFIG_SUPPORT_RAW_INITRD=y
# tb: -2 = autoboot without polling the console. UART0 is not wired on this tablet, so tstc() can see a
# phantom key, cancel autoboot and leave U-Boot at a prompt nobody can reach (seen on the first spike runs).
CONFIG_BOOTDELAY=-2
CONFIG_USE_BOOTCOMMAND=y
# tb: last_stage_init (tb7304x_debug.c) puts the console on LK's framebuffer with stdin = nulldev (UART0 is not
# wired, and phantom input would end `fastboot` via ctrlc()). The boot logic is boot.cmd, which LK loads to
# 0x44000000 as this image's ramdisk. Without it: fastboot; then back to LK (and Android) after 60 s.
CONFIG_BOOTCOMMAND="version; source 0x44000000; echo tb7304x: no boot script, fastboot usb 0; fastboot usb 0; sleep 60; reset"
CONFIG_HUSH_PARSER=y
CONFIG_DEFAULT_FDT_FILE="mt6737m-lenovo-tb7304x.dtb"
CONFIG_LOGLEVEL=7
CONFIG_SYS_STDIO_DEREGISTER=y
CONFIG_LOG=y
CONFIG_EVENT=y
# tb: keep LK's framebuffer (top 16 MiB) out of U-Boot's relocation area
CONFIG_SYS_MEM_TOP_HIDE=0x01000000
# tb: progress bands on LK's framebuffer (tb7304x_debug.c)
CONFIG_BOARD_EARLY_INIT_F=y
CONFIG_BOARD_EARLY_INIT_R=y
CONFIG_MISC_INIT_R=y
CONFIG_LAST_STAGE_INIT=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_BOOTMENU=y
CONFIG_CMD_GREPENV=y
CONFIG_CMD_MEMINFO=y
CONFIG_CMD_DM=y
CONFIG_CMD_CLK=y
# tb: no `gpt write` (could destroy the eMMC partition table)
# CONFIG_CMD_GPT is not set
# CONFIG_RANDOM_UUID is not set
CONFIG_CMD_LSBLK=y
CONFIG_CMD_MMC=y
# tb: no `mmc swrite`
CONFIG_CMD_PART=y
CONFIG_CMD_READ=y
# CONFIG_CMD_DATE is not set
CONFIG_CMD_PMIC=y
CONFIG_CMD_REGULATOR=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_CACHE=y
CONFIG_CMD_BCB=y
CONFIG_DOS_PARTITION=y
CONFIG_EFI_PARTITION=y
# CONFIG_NET is not set
# CONFIG_DM_WARN is not set
CONFIG_REGMAP=y
CONFIG_SYSCON=y
CONFIG_CLK=y
CONFIG_USB_FUNCTION_FASTBOOT=y
# tb: 0x41000000 overlaps the kernel range; 112 MiB at 0x50000000
CONFIG_FASTBOOT_BUF_ADDR=0x50000000
CONFIG_FASTBOOT_BUF_SIZE=0x7000000
# tb: no eMMC writes from fastboot until the port is proven
# CONFIG_FASTBOOT_FLASH is not set
CONFIG_FIRMWARE=y
# CONFIG_I2C is not set
CONFIG_DM_KEYBOARD=y
# CONFIG_MMC_QUIRKS is not set
CONFIG_MMC_IO_VOLTAGE=y
CONFIG_MMC_UHS_SUPPORT=y
CONFIG_MMC_HS400_ES_SUPPORT=y
CONFIG_MMC_HS400_SUPPORT=y
CONFIG_MMC_MTK=y
CONFIG_PHY=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_PINCTRL=y
CONFIG_PINCONF=y
CONFIG_PINCTRL_MT6735=y
CONFIG_PWRAP=y
CONFIG_MT6735_PWRAP=y
CONFIG_POWER_DOMAIN=y
CONFIG_MTK_POWER_DOMAIN=y
CONFIG_DM_PMIC=y
CONFIG_PMIC_MT6328=y
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_MT6328=y
CONFIG_DM_REGULATOR_FIXED=y
CONFIG_POWER_MT6328=y
CONFIG_DM_PWM=y
CONFIG_PWM_MTK=y
CONFIG_RAM=y
CONFIG_DM_RESET=y
CONFIG_DM_RTC=y
CONFIG_RTC_MT6328=y
CONFIG_DM_SERIAL=y
CONFIG_MTK_SERIAL=y
CONFIG_USB=y
CONFIG_DM_USB_GADGET=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_MUSB_MT6735=y
CONFIG_USB_MUSB_PIO_ONLY=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_VENDOR_NUM=0x0e8d
CONFIG_USB_GADGET_PRODUCT_NUM=0x201c
# tb: no USB mass storage (`ums 0 mmc 0` would export the whole eMMC) and no SDP
# tb: hardware watchdog from U-Boot until Linux mtk_wdt takes over (driver clamps at 15.98 s)
CONFIG_WDT=y
CONFIG_WDT_MTK=y
CONFIG_WATCHDOG_AUTOSTART=y
CONFIG_WATCHDOG_TIMEOUT_MSECS=15000
# tb: no SYSRESET: mach-mediatek/mt6735/init.c has its own reset_cpu() (TOPRGU SWRST)
# tb: read-only filesystems (U-Boot must never write Android's cache)
# CONFIG_EXT4_WRITE is not set
CONFIG_FS_FAT=y
# CONFIG_FAT_WRITE is not set
CONFIG_REGEX=y
CONFIG_LZO=y
CONFIG_ZSTD=y
# CONFIG_EFI_LOADER is not set
CONFIG_LMB_MAX_REGIONS=16
# tb: U-Boot console on LK's framebuffer (simple-framebuffer node in the DT)
CONFIG_VIDEO=y
CONFIG_VIDEO_SIMPLE=y
# tb: light text on black (the default is black on white); no U-Boot logo over the console
CONFIG_SYS_WHITE_ON_BLACK=y
# CONFIG_VIDEO_LOGO is not set
CONFIG_CONSOLE_MUX=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
