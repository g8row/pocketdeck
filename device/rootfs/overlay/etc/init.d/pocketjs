#!/sbin/openrc-run
# PocketJS desk companion on the panel (fb0 + Goodix touch), restarted if it dies.
# Binary and bundle: /opt/pocketjs (mainline/scripts/pocketjs-deploy.sh). Options: /etc/conf.d/pocketjs.
description="PocketJS desk companion (kiosk host)"
supervisor=supervise-daemon
command=/opt/pocketjs/pocketjs-kiosk
command_args="${POCKETJS_BUNDLE:-/opt/pocketjs/bundle}"
output_log=/var/log/pocketjs.log
error_log=/var/log/pocketjs.log
respawn_delay=2
respawn_max=0

depend() {
	need localmount
	after local
}

start_pre() {
	[ -x "$command" ] || { eerror "$command missing (run pocketjs-deploy.sh)"; return 1; }
	export POCKETJS_POWER POCKETJS_LINK POCKETJS_TOUCH_MASK POCKETJS_TOUCH_STALE_MS POCKETJS_TOUCH_LEARN
	: > "$output_log"
}
