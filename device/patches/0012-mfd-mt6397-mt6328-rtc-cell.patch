mfd: mt6397: add the MT6328 RTC cell (TB-7304X)

The MT6328 RTC is the MT6323/MT6397 block at PMIC offset 0x4000. rtc-mt6397 binds it with "mediatek,mt6323-rtc"
as a fallback compatible in the DT.


diff --git a/drivers/mfd/mt6397-core.c b/drivers/mfd/mt6397-core.c
index 3e58d0764..4f03f6d09 100644
--- a/drivers/mfd/mt6397-core.c
+++ b/drivers/mfd/mt6397-core.c
@@ -95,6 +95,15 @@ static const struct resource mt6323_keys_resources[] = {
 	DEFINE_RES_IRQ_NAMED(MT6323_IRQ_STATUS_FCHRKEY, "homekey"),
 };
 
+/* MT6328 RTC: same register layout as MT6323/MT6397, at PMIC offset 0x4000 */
+#define MT6328_RTC_BASE		0x4000
+#define MT6328_RTC_SIZE		0x40
+
+static const struct resource mt6328_rtc_resources[] = {
+	DEFINE_RES_MEM(MT6328_RTC_BASE, MT6328_RTC_SIZE),
+	DEFINE_RES_IRQ(MT6328_IRQ_STATUS_RTC),
+};
+
 static const struct resource mt6328_keys_resources[] = {
 	DEFINE_RES_IRQ_NAMED(MT6328_IRQ_STATUS_PWRKEY, "powerkey"),
 	DEFINE_RES_IRQ_NAMED(MT6328_IRQ_STATUS_HOMEKEY, "homekey"),
@@ -157,6 +166,11 @@ static const struct mfd_cell mt6328_devs[] = {
 		.num_resources = ARRAY_SIZE(mt6328_keys_resources),
 		.resources = mt6328_keys_resources,
 		.of_compatible = "mediatek,mt6328-keys"
+	}, {
+		.name = "mt6328-rtc",
+		.num_resources = ARRAY_SIZE(mt6328_rtc_resources),
+		.resources = mt6328_rtc_resources,
+		.of_compatible = "mediatek,mt6328-rtc"
 	},
 };
 
