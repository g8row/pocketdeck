# Copy to .pd.env (untracked) and adjust. Sourced by ./pd; plain shell assignments.

# Tablet ssh target over the USB network (default root@172.16.42.1). An ~/.ssh/config alias works.
#TAB=root@172.16.42.1

# Remote Docker host for kernel / U-Boot / rootfs / Mesa builds (an ssh alias), and the checkout directory there.
# Leave unset to build with the local Docker. The remote needs backup/partitions copied once (stock DTB, LK).
#PD_BUILD_HOST=buildbox
#PD_BUILD_DIR=/srv/build/pocketdeck

# Public key baked into the rootfs image's authorized_keys (default: ~/.ssh/id_ed25519.pub or id_rsa.pub).
#PD_SSH_PUBKEY=$HOME/.ssh/id_ed25519.pub

# Zig tarball for `pd build mesa`: a path on the machine that runs the build (the build host when PD_BUILD_HOST is set).
#PD_ZIG_TARBALL=/path/to/zig-x86_64-linux-0.14.1.tar.xz
