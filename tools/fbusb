#!/bin/sh
# fbusb: pyusb fastboot client for the TB-7304X LK (stock `fastboot` stalls on downloads there).
# First run creates tools/fbusb-venv with pyusb; libusb comes from Homebrew (brew install libusb) or the system.
#   fbusb <file> flash:<part>        upload, then flash
#   fbusb <file> boot                upload, then boot it from RAM
#   fbusb - "oem reboot-recovery"    command only
#   fbusb - getvar:product
set -e
R=$(cd "$(dirname "$0")/../.." && pwd)
V="$R/tools/fbusb-venv"
if [ ! -x "$V/bin/python" ] || ! "$V/bin/python" -c 'import usb' 2>/dev/null; then
	python3 -m venv "$V"
	"$V/bin/pip" install -q pyusb
fi
command -v adb >/dev/null && adb kill-server 2>/dev/null || true
exec "$V/bin/python" -I "$R/mainline/scripts/analysis/fb_send.py" "$@"
